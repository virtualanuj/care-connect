# Copy to .env (gitignored). Never commit real secrets.
ENV=dev
DATABASE_URL=postgresql+psycopg://careconnect:careconnect@localhost:5432/careconnect
# Required (>= 32 chars) when ENV is not "dev".
JWT_SECRET=
JWT_TTL_MINUTES=30
# Optional; only needed for the live Gemini contract test and production AI calls.
GEMINI_API_KEY=
# Gemini model used for triage and summaries.
GEMINI_MODEL=gemini-2.0-flash
# gemini (default) | fake | fake-down (deterministic dev stand-ins; only with ENV=dev).
LLM_PROVIDER=gemini

# Initial front-desk admin, created by `uv run python -m app.db.seed` (password >= 12 chars).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Region used to interpret phone numbers typed without a country code (ISO 3166 alpha-2).
DEFAULT_PHONE_REGION=IN
# Clinic time zone written into the settings row when the database is first migrated.
SEED_CLINIC_TIMEZONE=Asia/Kolkata

# Comma-separated exact origins allowed to call the API from a browser (never '*'); empty = none.
CORS_ALLOWED_ORIGINS=
# Requests declaring a larger body than this are rejected (bytes).
MAX_REQUEST_BYTES=1000000
