# Copy to .env (gitignored). Never commit real secrets.
ENV=dev
DATABASE_URL=postgresql+psycopg://careconnect:careconnect@localhost:5432/careconnect
# Required (>= 32 chars) when ENV is not "dev".
JWT_SECRET=
JWT_TTL_MINUTES=30
# Optional; only needed for the live Gemini contract test and production AI calls.
GEMINI_API_KEY=
